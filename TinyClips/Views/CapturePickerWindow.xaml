<Window
    x:Class="TinyClips.Views.CapturePickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TinyClips Capture">

    <Grid x:Name="RootPanel"
          Background="Transparent"
          CornerRadius="10"
          Padding="14,8"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <CompositeTransform TranslateY="12" ScaleX="0.97" ScaleY="0.97" />
        </Grid.RenderTransform>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.6" VerticalAlignment="Center">
                    <FontIcon x:Name="ModeIcon" Glyph="&#xE722;" FontSize="18" />
                </StackPanel>
                <AppBarSeparator />
                <Button x:Name="RegionButton" Click="OnRegionClick" ToolTipService.ToolTip="Select a region (R)" AutomationProperties.Name="Region capture" Style="{ThemeResource AccentButtonStyle}" Padding="12,7" CornerRadius="6" MinWidth="90">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE7A8;" FontSize="12" />
                        <TextBlock Text="Region" FontSize="13" FontWeight="Medium" TextTrimming="None" />
                    </StackPanel>
                </Button>
                <Button x:Name="ScreenButton" Click="OnScreenClick" ToolTipService.ToolTip="Full screen (S)" AutomationProperties.Name="Screen capture" Padding="12,7" CornerRadius="6" MinWidth="90">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE7F4;" FontSize="12" />
                        <TextBlock Text="Screen" FontSize="13" FontWeight="Medium" TextTrimming="None" />
                    </StackPanel>
                </Button>
                <Button x:Name="WindowButton" Click="OnWindowClick" ToolTipService.ToolTip="Select a window (W)" AutomationProperties.Name="Window capture" Padding="12,7" CornerRadius="6" MinWidth="100">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE737;" FontSize="12" />
                        <TextBlock Text="Window" FontSize="13" FontWeight="Medium" TextTrimming="None" />
                    </StackPanel>
                </Button>
                <AppBarSeparator />
                <DropDownButton x:Name="CountdownDropDown" AutomationProperties.Name="Countdown timer" Padding="12,7" CornerRadius="6" MinWidth="90">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE916;" FontSize="12" />
                        <TextBlock x:Name="CountdownLabel" Text="Off" FontSize="13" FontWeight="Medium" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Off" Click="OnCountdownOff" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="1s" Click="OnCountdown1" />
                            <MenuFlyoutItem Text="2s" Click="OnCountdown2" />
                            <MenuFlyoutItem Text="3s" Click="OnCountdown3" />
                            <MenuFlyoutItem Text="5s" Click="OnCountdown5" />
                            <MenuFlyoutItem Text="10s" Click="OnCountdown10" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <AppBarSeparator />
                <Button x:Name="CancelButton" Click="OnCancelClick" ToolTipService.ToolTip="Cancel (Esc)" AutomationProperties.Name="Cancel capture" Padding="0" Width="28" Height="28" CornerRadius="6"
                        Style="{ThemeResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
