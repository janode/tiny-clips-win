<Window
    x:Class="TinyClips.Views.CountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Countdown">
    <Grid Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="CountdownContainer" RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Grid.RenderTransform>
                <CompositeTransform ScaleX="0.5" ScaleY="0.5" />
            </Grid.RenderTransform>
            <Ellipse Width="120" Height="120" Fill="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="2" />
            <TextBlock x:Name="CountdownText" Text="3" FontSize="56" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" AutomationProperties.Name="Countdown timer" />
        </Grid>
    </Grid>
</Window>
