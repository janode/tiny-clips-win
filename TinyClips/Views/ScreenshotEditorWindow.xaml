<Window
    x:Class="TinyClips.Views.ScreenshotEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TinyClips — Edit Screenshot">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- MARK: Toolbar -->
        <Grid Grid.Row="0" Padding="12,8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="CropToggle" Click="OnToolClick" Tag="Crop"
                              ToolTipService.ToolTip="Crop (C)" Padding="8,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7A8;" FontSize="14" />
                        <TextBlock Text="Crop" FontSize="12" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="DrawToggle" Click="OnToolClick" Tag="Draw"
                              ToolTipService.ToolTip="Draw (D)" Padding="8,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xEE56;" FontSize="14" />
                        <TextBlock Text="Draw" FontSize="12" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ArrowToggle" Click="OnToolClick" Tag="Arrow"
                              ToolTipService.ToolTip="Arrow (A)" Padding="8,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        <TextBlock Text="Arrow" FontSize="12" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="BlurToggle" Click="OnToolClick" Tag="Blur"
                              ToolTipService.ToolTip="Blur (B)" Padding="8,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xEB42;" FontSize="14" />
                        <TextBlock Text="Blur" FontSize="12" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TextToggle" Click="OnToolClick" Tag="Text"
                              ToolTipService.ToolTip="Text (T)" Padding="8,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                        <TextBlock Text="Text" FontSize="12" />
                    </StackPanel>
                </ToggleButton>

                <AppBarSeparator />

                <Button x:Name="UndoButton" Click="OnUndoClick" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                        ToolTipService.ToolTip="Undo (Ctrl+Z)" Padding="8,6" CornerRadius="6">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="OnDiscardClick" Padding="12,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                        <TextBlock Text="Discard" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="OnSaveClick" Style="{ThemeResource AccentButtonStyle}" Padding="12,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                        <TextBlock Text="Save" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MARK: Properties Bar -->
        <Grid x:Name="PropertiesBar" Grid.Row="1" Padding="12,6"
              Background="{ThemeResource LayerFillColorAltBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
              Visibility="{x:Bind ViewModel.PropertiesBarVisible, Mode=OneWay}">

            <!-- Annotation properties (Draw / Arrow / Text) -->
            <StackPanel x:Name="AnnotationProperties" Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.AnnotationPropertiesVisible, Mode=OneWay}">
                <TextBlock Text="Color:" VerticalAlignment="Center" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Tag="#FF3B30" Click="OnColorClick" Width="24" Height="24" Padding="0" CornerRadius="12">
                        <Ellipse Width="16" Height="16" Fill="#FF3B30" />
                    </Button>
                    <Button Tag="#007AFF" Click="OnColorClick" Width="24" Height="24" Padding="0" CornerRadius="12">
                        <Ellipse Width="16" Height="16" Fill="#007AFF" />
                    </Button>
                    <Button Tag="#34C759" Click="OnColorClick" Width="24" Height="24" Padding="0" CornerRadius="12">
                        <Ellipse Width="16" Height="16" Fill="#34C759" />
                    </Button>
                    <Button Tag="#FF9500" Click="OnColorClick" Width="24" Height="24" Padding="0" CornerRadius="12">
                        <Ellipse Width="16" Height="16" Fill="#FF9500" />
                    </Button>
                    <Button Tag="#FFCC00" Click="OnColorClick" Width="24" Height="24" Padding="0" CornerRadius="12">
                        <Ellipse Width="16" Height="16" Fill="#FFCC00" />
                    </Button>
                    <Button Tag="#FFFFFF" Click="OnColorClick" Width="24" Height="24" Padding="0" CornerRadius="12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <Ellipse Width="16" Height="16" Fill="White" />
                    </Button>
                    <Button Tag="#000000" Click="OnColorClick" Width="24" Height="24" Padding="0" CornerRadius="12">
                        <Ellipse Width="16" Height="16" Fill="Black" />
                    </Button>
                </StackPanel>
                <AppBarSeparator />
                <TextBlock Text="Size:" VerticalAlignment="Center" FontSize="12" />
                <Slider x:Name="StrokeSizeSlider" Minimum="1" Maximum="20" Value="3" Width="120" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Crop properties -->
            <StackPanel x:Name="CropProperties" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.CropPropertiesVisible, Mode=OneWay}">
                <FontIcon Glyph="&#xE946;" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                <TextBlock Text="Drag to select the area to keep" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                <Button x:Name="ApplyCropButton" Click="OnApplyCropClick" IsEnabled="False"
                        Padding="8,4" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                        <TextBlock Text="Apply Crop" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="OnCancelCropClick" Padding="8,4" CornerRadius="6">
                    <TextBlock Text="Cancel" FontSize="12" />
                </Button>
            </StackPanel>

            <!-- Blur properties -->
            <StackPanel x:Name="BlurProperties" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.BlurPropertiesVisible, Mode=OneWay}">
                <FontIcon Glyph="&#xE946;" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                <TextBlock Text="Drag to select area to blur" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
            </StackPanel>
        </Grid>

        <!-- MARK: Editor Canvas -->
        <ScrollViewer Grid.Row="2" x:Name="EditorScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#1E1E1E"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.1"
                      MaxZoomFactor="5">
            <Grid x:Name="CanvasContainer"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="20">
                <Image x:Name="ScreenshotImage" Stretch="Fill" />
                <Canvas x:Name="AnnotationCanvas" Background="Transparent"
                        PointerPressed="OnCanvasPointerPressed"
                        PointerMoved="OnCanvasPointerMoved"
                        PointerReleased="OnCanvasPointerReleased" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
