<Window
    x:Class="TinyClips.Views.GifTrimmerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TinyClips — Trim GIF">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- MARK: Toolbar -->
        <Grid Grid.Row="0" Padding="12,8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PlayPauseButton" Click="OnPlayPauseClick" Padding="8,6" CornerRadius="6"
                        ToolTipService.ToolTip="Play/Pause (Space)">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="16" />
                </Button>
                <TextBlock x:Name="FrameLabel" Text="Frame 1 / 1" VerticalAlignment="Center"
                           FontSize="13" FontFamily="Consolas" Opacity="0.8" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Click="OnDiscardClick" Padding="12,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                        <TextBlock Text="Discard" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Click="OnSaveClick" Style="{ThemeResource AccentButtonStyle}"
                        Padding="12,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                        <TextBlock Text="Save" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MARK: GIF Preview -->
        <Grid Grid.Row="1" Background="#1E1E1E">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="5">
                <Image x:Name="GifPreviewImage" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" />
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        x:Name="RenderOverlay" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock Text="Encoding GIF..." FontSize="13" Opacity="0.7"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>

        <!-- MARK: Controls -->
        <Grid Grid.Row="2" Padding="16,12"
              Background="{ThemeResource LayerFillColorAltBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Frame range indicator with draggable handles -->
            <Grid x:Name="RangeContainer" Grid.Row="0" Height="24" Margin="0,0,0,8"
                  SizeChanged="OnRangeContainerSizeChanged">
                <!-- Track background -->
                <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Height="6" CornerRadius="3" VerticalAlignment="Center" />
                <!-- Selected range fill -->
                <Border x:Name="RangeBar" Background="{ThemeResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Left" Height="6" CornerRadius="3" VerticalAlignment="Center" />
                <!-- Left (start) handle -->
                <Border x:Name="LeftHandle" Width="14" Height="22" CornerRadius="4"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        PointerPressed="OnLeftHandlePointerPressed"
                        PointerMoved="OnHandlePointerMoved"
                        PointerReleased="OnHandlePointerReleased"
                        PointerCaptureLost="OnHandlePointerCaptureLost">
                    <Border CornerRadius="1" Background="White" Opacity="0.6"
                            Width="2" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- Right (end) handle -->
                <Border x:Name="RightHandle" Width="14" Height="22" CornerRadius="4"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        PointerPressed="OnRightHandlePointerPressed"
                        PointerMoved="OnHandlePointerMoved"
                        PointerReleased="OnHandlePointerReleased"
                        PointerCaptureLost="OnHandlePointerCaptureLost">
                    <Border CornerRadius="1" Background="White" Opacity="0.6"
                            Width="2" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Frame range controls -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Start frame:" VerticalAlignment="Center" FontSize="12" />
                    <NumberBox x:Name="StartFrameBox" Minimum="1" Maximum="1"
                               SpinButtonPlacementMode="Compact" Width="100"
                               ValueChanged="OnStartFrameChanged"
                               AutomationProperties.Name="Start frame" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="End frame:" VerticalAlignment="Center" FontSize="12" />
                    <NumberBox x:Name="EndFrameBox" Minimum="1" Maximum="1"
                               SpinButtonPlacementMode="Compact" Width="100"
                               ValueChanged="OnEndFrameChanged"
                               AutomationProperties.Name="End frame" />
                </StackPanel>
                <TextBlock x:Name="FrameCountLabel" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
            </StackPanel>

            <!-- Resize controls -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Width:" VerticalAlignment="Center" FontSize="12" />
                    <NumberBox x:Name="OutputWidthBox" Minimum="16" Maximum="7680"
                               SpinButtonPlacementMode="Compact" Width="110"
                               ValueChanged="OnOutputWidthChanged"
                               AutomationProperties.Name="Output width" />
                    <TextBlock Text="px" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
                </StackPanel>
                <TextBlock x:Name="DimensionsLabel" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
            </StackPanel>

            <!-- Info line -->
            <TextBlock x:Name="InfoLabel" Grid.Row="3" FontSize="12" Opacity="0.6" />

            <!-- Scrub slider -->
            <Slider x:Name="ScrubSlider" Grid.Row="4" Minimum="1" Maximum="1"
                    ValueChanged="OnScrubSliderChanged" Margin="0,4,0,0"
                    ToolTipService.ToolTip="Scrub through frames" />
        </Grid>
    </Grid>
</Window>
